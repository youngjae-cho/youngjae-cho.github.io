---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  /** Drop the status bar. The home page navigates from the console instead, so
   *  the bar there was a second copy of the same three destinations. Interior
   *  pages keep it — they have no console, and without it there is no way from
   *  one to another. */
  nav?: boolean;
  /** Drop the contact footer. The home page is two panels and stops — anything
   *  after the console would be content the console was supposed to lead to. */
  footer?: boolean;
  /** Marker class on <html> and <body>. Only the home page sets one ("home"),
   *  and the scroll-snap rules key off it: snapping belongs to a page that is
   *  exactly two panels tall, not to a page of case studies. */
  pageClass?: string;
}
const {
  title = 'Youngjae Cho — ML Research Engineer',
  description = 'Youngjae Cho — ML Research Engineer. Alignment, robustness, and optimization geometry, plus the pipelines that ship it. ICML 2023, AAAI 2024, NVIDIA Nemotron Hackathon winner.',
  active,
  nav = true,
  footer = true,
  pageClass,
} = Astro.props;
---

<!doctype html>
<html lang="en" class={pageClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {/* The console's mono, fetched alongside the stylesheet rather than after
        it. Without this the browser only learns the font exists once CSS has
        parsed, which on a page whose chrome is almost entirely mono means a
        visible re-set of every bar, plate and label a beat after first paint.
        crossorigin is not optional even same-origin: fonts are fetched in CORS
        mode, and a preload without it is a second, wasted request. */}
    <link rel="preload" href="/fonts/azeret-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {/* favicon.ico exists so the browser's implicit /favicon.ico request
        resolves instead of 404ing — that request is what bookmarks, history
        and the OS icon store go by, and a 404 there leaves whatever was
        cached before in place. The ?v= is a cache-bust: the file changed but
        the URL did not, so nothing had reason to re-fetch it. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <meta name="theme-color" content="#06080b" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {pageClass === 'home' && (
      /* Inline and in <head> on purpose: a bundled module script runs after
         first paint, so the page would flash before the boot covered it.
         sessionStorage can throw (private mode, blocked storage) — on any
         failure we simply don't boot, which is the safe direction. The flag is
         set here rather than when the animation ends, so a reload mid-boot
         doesn't replay it. */
      <script is:inline>
        try {
          if (!sessionStorage.getItem('magi-booted')) {
            sessionStorage.setItem('magi-booted', '1');
            document.documentElement.setAttribute('data-boot', '');
          }
        } catch (e) {}
      </script>
    )}
  </head>
  <body class={[nav ? null : 'no-nav', pageClass].filter(Boolean).join(' ') || undefined}>
    <div class="crt" aria-hidden="true"></div>
    {nav && <Nav active={active} />}
    <slot />
    {footer && <Footer />}
  </body>
</html>
