---
import type { Pub } from '../data/publications';
// `compact` drops the author list — used on the home page, where the full
// listing is a click away and the density isn't worth it.
interface Props { pub: Pub; compact?: boolean; index?: number; total?: number; }
const { pub, compact = false, index, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

// Author lists are stored with **markers** around my name — render them bold.
const authorsHtml = pub.authors.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
---
<article class={pub.featured ? 'card feature ticked' : 'card ticked'}>
  {pub.featured && (
    <svg class="feature-contour" viewBox="0 0 200 200" fill="none" stroke="var(--accent)" stroke-width="1" aria-hidden="true">
      <ellipse cx="100" cy="100" rx="20" ry="16" /><ellipse cx="100" cy="100" rx="42" ry="34" />
      <ellipse cx="100" cy="100" rx="66" ry="55" /><ellipse cx="100" cy="100" rx="92" ry="78" />
      <circle cx="100" cy="100" r="3" fill="var(--accent)" stroke="none" />
    </svg>
  )}
  <div class="card-top">
    {index && total && <span class="idx">Ref {pad(index)}/{pad(total)}</span>}
    <span class={pub.venueAlt ? 'badge alt' : 'badge'}>{pub.venue}</span>
    <span class="status">{pub.status}</span>
    {pub.role && (
      <span class={pub.roleFirst ? 'role-tag first' : 'role-tag'}>{pub.roleFirst ? '★ ' : ''}{pub.role}</span>
    )}
  </div>
  <h3>{pub.acronym && <span class="acro">{pub.acronym}</span>}{pub.acronym ? ' — ' : ''}{pub.title}</h3>
  {!compact && <p class="authors" set:html={authorsHtml}></p>}
  {pub.angle && <span class="angle">{pub.angle}</span>}
  <p set:html={pub.summary}></p>
  {pub.chips && (
    <div class="chips">{pub.chips.map((c) => <span class="chip" set:html={c}></span>)}</div>
  )}
  {pub.url && (
    <a class="more" href={pub.url}>Read the paper <span class="arr">→</span></a>
  )}
</article>
