---
// The page opens on two full-height panels that snap one to the next, so the
// second arrives as a card being turned rather than as more of the first.
//
// .intro-panel comes first and answers "who is this" — the name takes the display
// type, with the thesis and the venues under it. .magi-panel is the way in:
// the console alone, three plates, three destinations.
//
// The transition between them is a gesture handler, not CSS scroll-snap — see
// initPager below, and the note in global.css for why snap could not do it.
import Magi from './Magi.astro';
import Boot from './Boot.astro';
---
<Boot />

<section class="intro-panel" id="top">
  <canvas class="field" data-fit="right" aria-hidden="true"></canvas>
  <div class="intro-panel-in">
    <img class="avatar" src="/images/profile.png" alt="Youngjae Cho" width="112" height="112" />
    <div class="eyebrow">ML Research Engineer</div>
    <h1>Youngjae<br />Cho</h1>
    <p class="thesis">I design learning methods for <b>noisy, scarce, and shifting supervision</b> — and ship them to production.</p>
    <p class="lede">Four first-author papers on robust learning — <b>ICML 2023</b>, <b>AAAI 2024</b>, and current work on RL post-training for MLLMs.</p>
    <p class="affil">Research Scientist @ <a href="https://pyler.tech/">Pyler</a> &nbsp;·&nbsp; ex-Aiv &nbsp;·&nbsp; M.S./B.S. <a href="https://www.kaist.ac.kr/">KAIST</a></p>
    <div class="links">
      <a class="primary" href="/publications"><span class="dot"></span>Publications</a>
      <a href="/resume"><span class="dot"></span>Résumé</a>
      <a href="mailto:leon5760@gmail.com"><span class="dot"></span>Email</a>
    </div>
  </div>
  <a class="panel-cue" href="#magi">
    <span>MAGI System</span><i aria-hidden="true">▼</i>
  </a>
</section>

<section class="magi-panel" id="magi">
  <canvas class="field" data-fit="center" aria-hidden="true"></canvas>
  <div class="magi-panel-in">
    <Magi />
    <p class="magi-hint">Select a node</p>
  </div>
</section>

<script>
  // Loss-landscape contour field — references the sharpness / geometry thread
  // in the research (GAPO, SAAL). Two instances now, one per panel, so the
  // fit differs: the intro keeps the original off-centre figure behind its
  // text column, while the console panel centres and scales the rings out past
  // the panel, which paints on opaque black and would otherwise hide them.
  //
  // Only the visible one animates. Two uncapped rAF loops for a decoration
  // nobody is looking at is not a trade worth making.
  function initField(cv: HTMLCanvasElement) {
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const centred = cv.dataset.fit === 'center';
    let W = 0, H = 0, DPR = 1, cx = 0, cy = 0, SC = 1;
    let trail: number[][] = [];

    function resize() {
      const r = cv.parentElement!.getBoundingClientRect();
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width; H = r.height;
      cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
      cv.style.width = W + 'px'; cv.style.height = H + 'px';
      ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
      cx = W * (centred ? 0.5 : 0.74);
      cy = H * (centred ? 0.5 : 0.46);
      SC = centred ? Math.max(W, H) / 620 : 1;
    }

    // Radar grid: concentric rings plus radial spokes, drawn thin in structural
    // green — the reference's defence-plot look. The rings still carry the
    // original meaning (a loss landscape), just with the warp dialled right down
    // so they read as instrument graticule rather than terrain.
    function contour(level: number, t: number) {
      const baseR = (22 + level * 29) * SC;
      const segs = 120;
      ctx!.beginPath();
      for (let i = 0; i <= segs; i++) {
        const a = (i / segs) * Math.PI * 2;
        const warp = 1
          + 0.035 * Math.sin(a * 3 + level * 0.45 + t * 0.00026)
          + 0.02 * Math.sin(a * 5 - level * 0.3 - t * 0.00017);
        const rr = baseR * warp;
        const x = cx + Math.cos(a) * rr * 1.14;
        const y = cy + Math.sin(a) * rr * 0.94;
        if (i === 0) ctx!.moveTo(x, y); else ctx!.lineTo(x, y);
      }
      ctx!.closePath();
      ctx!.stroke();
    }

    function spokes() {
      const R = (22 + 9 * 29) * SC;
      ctx!.strokeStyle = 'rgba(0,232,60,0.13)';
      ctx!.lineWidth = 1;
      for (let k = 0; k < 12; k++) {
        const a = (k / 12) * Math.PI * 2;
        ctx!.beginPath();
        ctx!.moveTo(cx, cy);
        ctx!.lineTo(cx + Math.cos(a) * R * 1.14, cy + Math.sin(a) * R * 0.94);
        ctx!.stroke();
      }
    }

    function rings(t: number) {
      spokes();
      for (let L = 1; L <= 9; L++) {
        ctx!.strokeStyle = L <= 3 ? 'rgba(0,232,60,0.30)' : 'rgba(0,232,60,0.15)';
        ctx!.lineWidth = 1;
        contour(L, t);
      }
    }

    function draw(t: number) {
      ctx!.clearRect(0, 0, W, H);
      rings(t);
      const period = 15000;
      const ph = (t % period) / period;
      const ang = ph * Math.PI * 6 + 0.6;
      const rad = (1 - ph) * 250 * SC + 6;
      const mx = cx + Math.cos(ang) * rad * 1.18;
      const my = cy + Math.sin(ang) * rad * 0.92;
      trail.push([mx, my]); if (trail.length > 46) trail.shift();
      for (let k = 1; k < trail.length; k++) {
        const alpha = (k / trail.length) * 0.55;
        ctx!.strokeStyle = 'rgba(255,59,0,' + alpha.toFixed(3) + ')';
        ctx!.lineWidth = 1.4;
        ctx!.beginPath(); ctx!.moveTo(trail[k - 1][0], trail[k - 1][1]); ctx!.lineTo(trail[k][0], trail[k][1]); ctx!.stroke();
      }
      ctx!.beginPath(); ctx!.arc(mx, my, 4.5, 0, Math.PI * 2);
      ctx!.fillStyle = '#ff3b00'; ctx!.fill();
      ctx!.beginPath(); ctx!.arc(mx, my, 9, 0, Math.PI * 2);
      ctx!.strokeStyle = 'rgba(255,59,0,0.55)'; ctx!.lineWidth = 1.2; ctx!.stroke();
    }

    function staticDraw() {
      ctx!.clearRect(0, 0, W, H);
      rings(3000);
      ctx!.beginPath(); ctx!.arc(cx, cy, 4.5, 0, Math.PI * 2);
      ctx!.fillStyle = '#ff3b00'; ctx!.fill();
    }

    let raf = 0, start: number | null = null, visible = true;
    function loop(ts: number) {
      if (start === null) start = ts;
      draw(ts - start);
      raf = requestAnimationFrame(loop);
    }
    function stop() { if (raf) { cancelAnimationFrame(raf); raf = 0; } }
    function run() {
      stop();
      if (reduce) { staticDraw(); return; }
      start = null; raf = requestAnimationFrame(loop);
    }
    function boot() { resize(); if (visible) run(); else { stop(); staticDraw(); } }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        for (const e of entries) {
          visible = e.isIntersecting;
          if (visible) run(); else stop();
        }
      }, { threshold: 0 }).observe(cv.parentElement!);
    }

    let rt: number;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(boot, 150); });
    boot();
  }
  document.querySelectorAll<HTMLCanvasElement>('canvas.field').forEach(initField);

  // One gesture, one panel.
  //
  // CSS scroll-snap alone is not a page turn: it only settles once a gesture
  // has ENDED, so a drag tracks the finger the whole way down and a short one
  // rubber-bands back. Measured on the shipped build — a 40% push returns to
  // 0, a 65% push lands on the console. Correct behaviour, but what it feels
  // like in the hand is scrolling that argues with you.
  //
  // So the gesture itself becomes the trigger: hold the page still, and on
  // release move a whole panel. Snap stays in the stylesheet as the backstop
  // for keyboard, hash links and anyone whose JS never arrives.
  function initPager() {
    if (!document.documentElement.classList.contains('home')) return;
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.intro-panel, .magi-panel'));
    if (panels.length < 2) return;

    // Same threshold the stylesheet uses to turn panels on at all. Below it
    // the panels are ordinary blocks, and taking the scroll away from someone
    // on a short screen would strand them mid-page.
    const paged = matchMedia('(min-height: 700px)');
    let index = 0;
    let locked = false;

    // Panel one is position:sticky, and offsetTop on a STUCK element reports
    // where it is currently painted, not where it sits in flow — so once you
    // were on the console, "scroll back to panel one" resolved to the position
    // you were already at, and there was no way back up. Heights are unaffected
    // by sticky, so accumulate those instead.
    function tops() {
      let acc = 0;
      return panels.map((p) => {
        const t = acc;
        acc += p.getBoundingClientRect().height;
        return t;
      });
    }

    function go(next: number) {
      const i = Math.max(0, Math.min(panels.length - 1, next));
      if (i === index) return;
      index = i;
      locked = true;
      window.scrollTo({ top: tops()[i] });
      window.setTimeout(() => { locked = false; }, 620);
    }

    // Anything else that moves the page — keyboard, a hash, the browser
    // restoring a position — has to leave the index telling the truth.
    window.addEventListener('scroll', () => {
      if (locked) return;
      const y = window.scrollY;
      let nearest = 0, best = Infinity;
      tops().forEach((t, i) => {
        const d = Math.abs(t - y);
        if (d < best) { best = d; nearest = i; }
      });
      index = nearest;
    }, { passive: true });

    window.addEventListener('wheel', (e) => {
      if (!paged.matches || locked || Math.abs(e.deltaY) < 4) return;
      e.preventDefault();
      go(index + (e.deltaY > 0 ? 1 : -1));
    }, { passive: false });

    let startY = 0, tracking = false;
    window.addEventListener('touchstart', (e) => {
      // Single finger only — pinch-zoom has to keep working.
      tracking = e.touches.length === 1;
      startY = tracking ? e.touches[0].clientY : 0;
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      // Hold the page still, so the gesture reads as a swipe and not a drag.
      if (tracking && paged.matches && e.cancelable) e.preventDefault();
    }, { passive: false });

    window.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;
      if (!paged.matches || locked) return;
      const dy = startY - e.changedTouches[0].clientY;
      // Short enough that a flick counts, long enough that a tap never does.
      if (Math.abs(dy) > 36) go(index + (dy > 0 ? 1 : -1));
    });
  }
  initPager();
</script>
