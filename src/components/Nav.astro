---
interface Props { active?: string; }
const { active } = Astro.props;
const links = [
  { href: '/publications', label: 'publications', key: 'publications' },
  { href: '/projects', label: 'projects', key: 'projects' },
];
---
<nav>
  <div class="nav-in">
    <a class="brand" href="/">Youngjae&nbsp;Cho</a>
    <span class="nav-code">SEOUL · KR &nbsp;//&nbsp; STATUS <b>NOMINAL</b></span>
    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href} class={active === l.key ? 'active' : undefined}>{l.label}</a>
      ))}
      {/* Same-page, not "/#contact" — the home page has no footer to land on
          any more, and the bar only renders on pages that do have one. */}
      <a href="#contact">contact</a>
    </div>
  </div>
</nav>
