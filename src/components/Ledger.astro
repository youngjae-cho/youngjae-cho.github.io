---
// Verification signals, first screen. Three, each a distinct claim — the venue
// stat was cut because the hero lede already names ICML 2023 and AAAI 2024
// directly above it. The value sits in a rotated plate; the inner span
// counter-rotates so the text stays level.
const stats = [
  { n: '06', k: 'Papers · 4 first-author' },
  { n: 'WIN', k: 'NVIDIA Nemotron ’26', win: true },
  { n: '+0.080', k: 'Auto-label macro F1' },
];
---
<div class="ledger">
  <div class="ledger-in">
    {stats.map((s) => (
      <div class="stat">
        <span class={s.win ? 'n win' : 'n'}><span>{s.n}</span></span>
        <span class="k">{s.k}</span>
      </div>
    ))}
  </div>
</div>
