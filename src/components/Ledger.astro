---
// Verification signals, first screen. Peer review on the left, shipped impact on the right.
const stats = [
  { n: '06', k: 'Papers' },
  { n: '04', k: 'First-author' },
  { n: "ICML ’23", k: '+ AAAI ’24' },
  { n: 'Winner', k: 'NVIDIA Nemotron ’26', win: true },
  { n: '+0.080', k: 'Auto-label macro F1' },
];
---
<div class="ledger">
  <div class="ledger-in">
    {stats.map((s) => (
      <div class="stat">
        <span class={s.win ? 'n win' : 'n'}>{s.n}</span>
        <span class="k">{s.k}</span>
      </div>
    ))}
  </div>
</div>
