---
// MAGI triptych in triangle formation — one node at the apex, two abreast
// below, tied by a bus rather than an arrow. The three are independent
// domains, not stages of a pipeline: a 2-over-1 stack read as
// research → engineering → serving, which is the wrong claim. Research takes
// the apex.
//
// Styling follows the reference display: plates filled with signal colour and
// the lettering punched out in black, corners raked. All three share one
// colour — they're peers, and any differentiation implied a hierarchy that
// isn't there.
//
// Keep the sub-lines true of BOTH jobs; don't promote a single project's
// constraint or model size into a general descriptor.
const apex = {
  id: 'MELCHIOR·1', fn: 'Research',
  sub: 'Alignment · robustness · learning under imperfect supervision',
};
const base = [
  { id: 'BALTHASAR·2', fn: 'Engineering', sub: 'Training & inference efficiency · pipelines · tooling' },
  { id: 'CASPER·3', fn: 'Serving', sub: 'TensorRT · Triton · vLLM in production' },
];
---
<div class="magi" aria-label="Three independent domains: research, engineering, serving">
  <div class="magi-bar">
    <span class="magi-code">CODE:751</span>
    <span class="magi-rule"></span>
    <span class="magi-word">MAGI</span>
  </div>

  <div class="magi-tri">
    <div class="plate apex">
      <span class="p-id">{apex.id}</span>
      <span class="p-fn">{apex.fn}</span>
      <span class="p-sub">{apex.sub}</span>
    </div>
    <div class="magi-link" aria-hidden="true"></div>
    {base.map((n) => (
      <div class="plate">
        <span class="p-id">{n.id}</span>
        <span class="p-fn">{n.fn}</span>
        <span class="p-sub">{n.sub}</span>
      </div>
    ))}
  </div>

  <div class="magi-status">
    <span class="ms-lbl">Deliberation</span>
    <span class="ms-dots"></span>
    <span class="ms-val">3/3 Approved</span>
  </div>
</div>
