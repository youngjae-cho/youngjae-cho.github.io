---
// MAGI system panel, laid out like the reference display: three heavy plates
// placed at the points of a triangle with the MAGI wordmark held in the middle
// of them. The triangle is the ARRANGEMENT — nothing draws its edges. An
// earlier pass drew the sides in and it just looked like an org chart.
//
// In the show the MAGI are three personalities of one person, not three stages
// of a process — so these have to be three genuinely different voices. An
// earlier cut used Research / Engineering / Serving, but serving is a subset of
// engineering; it wasn't a third voice, just the second one again. The three
// questions asked of any piece of work are: is it true, does it run, does it
// matter. Research, Engineering, Product.
//
// Research takes the top point. Nothing implies a direction of flow — they
// deliberate, they don't hand off.
//
// Plates are filled with signal colour and the lettering punched out in black,
// with the inner edge of each lower plate raked toward the centre. Sub-lines
// stay to a single tag pair so all three plates keep the same mass — and stay
// true of BOTH jobs, rather than promoting one project's constraint.
//
// Each plate is a link — the panel is the way into the site, not a decoration
// beside it. Destinations follow the voice, not the page count: Research reads
// the papers, Engineering the tooling, Product the systems that shipped. The
// lower two used to both land on /projects, so the panel promised three ways in
// and delivered two; they are separate pages now, and membership is a `track`
// field on each case rather than a list kept per page.
//
// The home page is the hub these three lead out of, so they navigate in place
// rather than spawning tabs: a cut you can watch needs the viewport it cuts.
const top = { id: 'MELCHIOR·1', fn: 'Research', sub: 'Alignment · robustness', href: '/publications', to: 'publications' };
const left = { id: 'BALTHASAR·2', fn: 'Engineering', sub: 'Training · inference · serving', href: '/engineering', to: 'engineering cases' };
const right = { id: 'CASPER·3', fn: 'Product', sub: 'Auto-labeling · synthesis · OCR', href: '/product', to: 'product cases' };

---
<nav class="magi" aria-label="Research, engineering, product — and the person they are sides of">
  <div class="magi-bar">
    <span class="magi-code">CODE:751</span>
    {/* Seoul time, not the viewer's — the nav already says SEOUL · KR, and a
        local clock there would contradict it. Filled in on the client; the
        dashes are what a static build can honestly render. */}
    <span class="magi-clock" id="magi-clock">KST --:--:--</span>
    <span class="magi-rule"></span>
    <span class="magi-word">MAGI SYSTEM</span>
  </div>

  <div class="magi-tri">
    {/* The three pairwise links. Drawn under the plates and deliberately
        overshooting into them, so only the segments crossing open black show
        and the endpoints never need to land pixel-exact.
        preserveAspectRatio="none" keeps the coordinates in plain percentages;
        non-scaling-stroke keeps the line 1px through the distortion. */}
    <svg class="magi-edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <line x1="44" y1="32" x2="22" y2="68" vector-effect="non-scaling-stroke" />
      <line x1="56" y1="32" x2="78" y2="68" vector-effect="non-scaling-stroke" />
      <line x1="26" y1="82" x2="74" y2="82" vector-effect="non-scaling-stroke" />
    </svg>

    <a class="plate p-top" href={top.href}
       aria-label={`${top.fn} — ${top.to}`}>
      <span class="p-id">{top.id}<span class="p-out" aria-hidden="true">→</span></span>
      <span class="p-fn">{top.fn}</span>
      <span class="p-sub">{top.sub}</span>
    </a>

    <a class="plate p-left" href={left.href}
       aria-label={`${left.fn} — ${left.to}`}>
      <span class="p-id">{left.id}<span class="p-out" aria-hidden="true">→</span></span>
      <span class="p-fn">{left.fn}</span>
      <span class="p-sub">{left.sub}</span>
    </a>

    {/* The fourth way in, and the only one that isn't work.
        In the show the MAGI are three aspects of ONE person — Naoko Akagi split
        herself into scientist, mother, woman — so the point where the three
        plates converge is not a label, it is the person they are aspects of.
        This site had been using the figure for three aspects of one JOB, with
        the centre left as decoration.
        It goes here rather than becoming a fourth plate for two reasons: the
        home page is two panels and stops, so there is no room to add one; and a
        fourth plate would make a music channel weigh the same as the research.
        The centre is off to one side of the hierarchy, which is where it
        belongs. */}
    {/* The hexagon is the wordmark's own ground, not a badge behind it. It has
        to be: this element sits on top of the three connector lines and masks
        them where they would otherwise run into the lettering, so whatever
        shape carries the black IS the shape you see. Stretched to the box with
        preserveAspectRatio="none" and held to 1px by non-scaling-stroke —
        the same pair .magi-edges uses a few lines up. */}
    <a class="magi-core" href="/core" aria-label="Elsewhere — what the three sides are sides of">
      <svg class="core-hex" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
        <polygon points="9,0 91,0 100,20 91,40 9,40 0,20" vector-effect="non-scaling-stroke" />
      </svg>
      <span>MAGI</span>
    </a>

    <a class="plate p-right" href={right.href}
       aria-label={`${right.fn} — ${right.to}`}>
      <span class="p-id">{right.id}<span class="p-out" aria-hidden="true">→</span></span>
      <span class="p-fn">{right.fn}</span>
      <span class="p-sub">{right.sub}</span>
    </a>
  </div>

  <div class="magi-status">
    <span class="ms-lbl">Deliberation</span>
    <span class="ms-dots"></span>
    <span class="ms-val">3/3 Approved</span>
  </div>
</nav>

{/* The cut between the panel and its destination. The show never dissolves —
    it hard-cuts, holds a stamped verdict on black, and moves. So every step
    here is on steps() timing, not an ease: the ground snaps to black, the
    verdict slams in over-size and lands, three bars sweep, the wipe closes.
    Inert until a plate is clicked, and skipped entirely under reduced motion. */}
<div class="magi-cut" id="magi-cut" aria-hidden="true">
  {/* The three units deliberate, which is the thing the console has been
      claiming in its status line all along and never showing. Same readout
      form as the boot — see .rdo — and the same per-element --d beat, because
      an nth-of-type rule over same-tag siblings is the trap that skipped
      Balthasar in the boot sequence. */}
  <div class="mc-delib rdo">
    <span class="mc-lbl">MAGI · Deliberation</span>
    <span class="mc-unit rdo-l" style="--d:.14s"><i>Melchior·1</i><s></s>
      <span class="mc-st"><em>Deliberating</em><b>Approved</b></span></span>
    <span class="mc-unit rdo-l" style="--d:.175s"><i>Balthasar·2</i><s></s>
      <span class="mc-st"><em>Deliberating</em><b>Approved</b></span></span>
    <span class="mc-unit rdo-l" style="--d:.21s"><i>Casper·3</i><s></s>
      <span class="mc-st"><em>Deliberating</em><b>Approved</b></span></span>
    <span class="mc-tally" style="--d:.34s">3 / 3 Approved</span>
  </div>
  {/* No destination name here on purpose. The cut reports a verdict; which page
      that verdict opens is the page's own business, and naming it turned a
      stamp into a signpost. */}
  <div class="mc-verdict"><b>可決</b></div>
  <div class="mc-wipe"></div>
</div>

{/* The other cut, for the one destination that isn't a verdict.
    An A.T. field is the wall between one person and another — Anno's own
    reading — and canonically it is invisible until something pushes on it, and
    can only be brought down by another field. So the way to the personal page
    is not deliberated and stamped like the work is: it is a barrier that shows
    itself, holds, and is neutralised.
    Same idiom as the cut above and deliberately not the same event: it reuses
    that one's ground and wipe keyframes, swaps red for the field's amber, and
    stamps 中和 where the other stamps 可決. */}
<div class="at-cut" id="at-cut" aria-hidden="true">
  {/* Empty on purpose — the rings are built by buildField() below.
      Authored as markup it was 1009 <polygon> nodes and 112KB of HTML on the
      one page that is the site's front door, against 8.7KB for /publications.
      None of it can ever be seen without JS either: with scripts off, clicking
      a node just navigates and no overlay exists at all. So it is dead weight
      in the document for every visitor, and dead weight twice over for the
      ones who never click. */}
  <svg class="at-hex" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true"></svg>
  {/* The strike. The field used to come apart for no stated reason — it simply
      began to go. This lands on the centre one beat before the first ring lets
      go, so the collapse reads as caused rather than scheduled. */}
  <svg class="at-hit" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true"></svg>
  <div class="at-readout">
    <span class="mc-lbl">A.T. Field</span>
    <span class="at-stamp"><b>中和</b><em>Neutralized</em></span>
  </div>
  <div class="mc-wipe"></div>
</div>

<script>
  // Seoul wall-clock in the MAGI bar. Intl does the zone, so this stays correct
  // wherever the page is opened from and needs no offset arithmetic.
  function initMagiClock() {
    const el = document.getElementById('magi-clock');
    if (!el) return;
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Seoul',
      hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
    });
    const tick = () => { el.textContent = 'KST ' + fmt.format(new Date()); };
    tick();
    setInterval(tick, 1000);
  }
  initMagiClock();

  // Runs a cut, then navigates. The animation is decoration over links that
  // already work: modified clicks fall through to the browser, reduced motion
  // goes straight there, and a stalled navigation still lands via the fallback
  // timer — nothing here can leave a visitor stuck behind a black overlay.
  //
  // Two overlays now, because the console has two kinds of destination. The
  // work is deliberated and stamped; the person behind it is behind a field.
  // Which one runs is the ONLY difference between the two paths, so the arming
  // is written once and handed an overlay.
  // The field: octagons nested about one centre, growth-ring fashion.
  //
  // This was a hexagonal LATTICE first, and a lattice was the wrong object. A
  // tiling has no centre — it is the same everywhere, which is why it read as a
  // sheet of graphene rather than as a field: there was nothing for it to be a
  // field AROUND. The reference's is a stack of octagons about the point of
  // contact, and once the rings are concentric, scaling them is no longer a
  // zoom — it is the field closing in, or coming apart.
  //
  // Every ring keeps the SAME orientation. There was a second set turned 22.5°
  // for a while — that was mine, not the reference's, added to make one set look
  // denser. Rendered against an aligned one it loses the shape entirely: the
  // corners of a turned octagon land in the flats of its neighbours and the
  // stack rounds off into a spirograph, which is the lattice problem again in
  // another form. Growth rings do not turn against each other, so neither do
  // these; the density comes from a smaller gap in one set instead.
  //
  // Radii are viewBox units against a 100-unit box that is sliced to fill the
  // viewport, so they are fractions of the long edge rather than pixels. The
  // outermost has to clear the corner of the visible region — about 59 units on
  // a 16:10 screen — and the animation pushes past that again at 2.6x.
  function buildField() {
    const field = document.querySelector('.at-hex');
    if (!field) return;
    const NS = 'http://www.w3.org/2000/svg';
    const CX = 50, CY = 50, R0 = 4, GAP = 2, RINGS = 38;
    // Vertices at 22.5° + k·45° put a flat edge top and bottom, which is how the
    // reference's sit.
    const unit = Array.from({ length: 8 }, (_, k) => {
      const a = (Math.PI / 8) + (k * Math.PI) / 4;
      return [Math.cos(a), Math.sin(a)];
    });
    const frag = document.createDocumentFragment();
    for (let i = 0; i < RINGS; i++) {
      const r = R0 + i * GAP;
      const p = document.createElementNS(NS, 'polygon');
      p.setAttribute('points', unit
        .map(([ux, uy]) => (CX + ux * r).toFixed(2) + ',' + (CY + uy * r).toFixed(2))
        .join(' '));
      // Falls off outward, so the figure reads as centred on something rather
      // than as a flat pattern that happens to be round. Smooth across the whole
      // stack now it is one set — interleaving two made every other ring a step
      // brighter than the one just inside it.
      p.setAttribute('stroke-opacity', (1 - (i / RINGS) * 0.62).toFixed(2));
      // Ring index, which the collapse staggers on: the field gives from the
      // inside out, so what it leaves behind is an opening rather than nothing.
      // The per-ring delay in the stylesheet is tuned to RINGS — doubling the
      // count without halving it would leave the outermost giving after the
      // overlay has gone.
      p.style.setProperty('--i', String(i));
      frag.appendChild(p);
    }
    field.appendChild(frag);

    // The point of contact: a hot core and eight lances driven out of it.
    // Wedges rather than strokes, because a stroked line held at 1px by
    // non-scaling-stroke stays a hairline however hard it is meant to be
    // hitting — the lances have to thicken as they go.
    const hit = document.querySelector('.at-hit');
    if (!hit) return;
    const poly = (pts: string, cls?: string) => {
      const e = document.createElementNS(NS, 'polygon');
      e.setAttribute('points', pts);
      if (cls) e.setAttribute('class', cls);
      hit.appendChild(e);
    };
    for (let k = 0; k < 8; k++) {
      const a = (k * Math.PI) / 4, d = 0.05, L = 24;
      poly([
        `${CX},${CY}`,
        `${(CX + Math.cos(a - d) * L).toFixed(2)},${(CY + Math.sin(a - d) * L).toFixed(2)}`,
        `${(CX + Math.cos(a + d) * L).toFixed(2)},${(CY + Math.sin(a + d) * L).toFixed(2)}`,
      ].join(' '));
    }
    poly(unit.map(([ux, uy]) => (CX + ux * 2.4).toFixed(2) + ',' + (CY + uy * 2.4).toFixed(2)).join(' '), 'at-core');
  }

  function initCuts() {
    // Matches the .magi-cut / .at-cut durations in the stylesheet. The
    // deliberation cut is .78s and the field cut .82s; the longer one sets this
    // so neither navigates out from under its own wipe.
    const DUR = 820;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    const overlays = ['magi-cut', 'at-cut']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    if (!overlays.length) return;

    // The panel is authored inside .magi-panel-in, which sets z-index:2 and so
    // opens a stacking context — a fixed overlay declared in there resolves
    // its z-index against .magi-panel, not the page, and loses to the sticky
    // nav (and .magi-panel's overflow:hidden crops it to that panel's box).
    // Reparent to <body> so a cut covers the viewport it means to cover.
    overlays.forEach((o) => {
      if (o.parentElement !== document.body) document.body.appendChild(o);
    });

    // Back-navigation can restore this page from the bfcache mid-cut, so the
    // overlays have to be cleared on the way back IN. Not on the way out —
    // pagehide fires while the old page is still on screen, and lifting the
    // black there flashes the page you just cut away from.
    const clear = () => {
      overlays.forEach((o) => o.removeAttribute('data-run'));
      document.querySelectorAll('.mc-sel').forEach((el) => el.classList.remove('mc-sel'));
    };
    window.addEventListener('pageshow', clear);

    const arm = (a: HTMLAnchorElement | null, overlay: HTMLElement | null, before?: () => void) => {
      if (!a || !overlay) return;
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        const href = a.getAttribute('href');
        if (!href) return;
        e.preventDefault();
        if (reduce.matches) { window.location.href = href; return; }
        before?.();
        a.classList.add('mc-sel');
        overlay.setAttribute('data-run', '');
        window.setTimeout(() => { window.location.href = href; }, DUR - 40);
        window.setTimeout(clear, DUR + 2500);
      });
    };

    const cut = document.getElementById('magi-cut');
    const units = document.querySelectorAll<HTMLElement>('.mc-unit');
    const plates = Array.from(document.querySelectorAll<HTMLAnchorElement>('.magi .plate'));
    plates.forEach((a, i) => {
      // Mark the unit that answered for this plate. The plates are authored in
      // MAGI order — Melchior, Balthasar, Casper — and so are the rows, so the
      // index is the pairing; nothing needs to parse a label to find it.
      arm(a, cut, () => {
        units.forEach((u) => u.classList.remove('mc-on'));
        units[i]?.classList.add('mc-on');
      });
    });

    const core = document.querySelector<HTMLAnchorElement>('.magi-core');
    const at = document.getElementById('at-cut');
    // Only worth drawing 500 polygons if there is something to run them.
    if (core && at) { buildField(); arm(core, at); }
  }
  initCuts();
</script>
