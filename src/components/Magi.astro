---
// MAGI triptych in triangle formation — one node at the apex, two abreast
// below, tied by a bus rather than an arrow. The three are independent
// domains, not stages of a pipeline: a 2-over-1 stack read as
// research → engineering → serving, which is the wrong claim. Research takes
// the apex.
//
// Styling follows the reference display: plates filled with signal colour and
// the lettering punched out in black, corners raked. All three share one
// colour — they're peers, and any differentiation implied a hierarchy that
// isn't there.
//
// Sub-lines are a tag pair, not a description — keep them to one line each so
// the three plates stay the same height and the triangle reads cleanly. And
// keep them true of BOTH jobs: don't promote a single project's constraint or
// model size into a general descriptor.
const apex = { id: 'MELCHIOR·1', fn: 'Research', sub: 'Alignment · robustness' };
const base = [
  { id: 'BALTHASAR·2', fn: 'Engineering', sub: 'Efficiency · pipelines' },
  { id: 'CASPER·3', fn: 'Serving', sub: 'TensorRT · Triton · vLLM' },
];
---
<div class="magi" aria-label="Three independent domains: research, engineering, serving">
  <div class="magi-bar">
    <span class="magi-code">CODE:751</span>
    <span class="magi-rule"></span>
    <span class="magi-word">MAGI</span>
  </div>

  <div class="magi-tri">
    <div class="plate apex">
      <span class="p-id">{apex.id}</span>
      <span class="p-fn">{apex.fn}</span>
      <span class="p-sub">{apex.sub}</span>
    </div>
    {/* The triangle's own edges: two sides meeting at the apex, plus the base
        that closes it. preserveAspectRatio="none" lets the coordinates stay in
        plain percentages; non-scaling-stroke keeps the line 1px through it. */}
    <svg class="magi-edges" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <line x1="50" y1="2" x2="25" y2="98" vector-effect="non-scaling-stroke" />
      <line x1="50" y1="2" x2="75" y2="98" vector-effect="non-scaling-stroke" />
      <line x1="25" y1="98" x2="75" y2="98" vector-effect="non-scaling-stroke" />
    </svg>
    {base.map((n) => (
      <div class="plate">
        <span class="p-id">{n.id}</span>
        <span class="p-fn">{n.fn}</span>
        <span class="p-sub">{n.sub}</span>
      </div>
    ))}
  </div>

  <div class="magi-status">
    <span class="ms-lbl">Deliberation</span>
    <span class="ms-dots"></span>
    <span class="ms-val">3/3 Approved</span>
  </div>
</div>
