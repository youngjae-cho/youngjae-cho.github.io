---
import type { Project } from '../data/projects';
import DecisionTree from './DecisionTree.astro';
import GapDiagram from './GapDiagram.astro';
interface Props { project: Project; index?: number; total?: number; }
const { project: p, index, total } = Astro.props;
// Zero-padded so the column stays put whether there are 3 cases or 30.
const pad = (n: number) => String(n).padStart(2, '0');
---
<article class="case ticked" id={p.key}>
  <div class="case-grid">
    <div class="case-meta">
      {index && total && <span class="idx">Case {pad(index)}/{pad(total)}</span>}
      {p.tags.length === 1 ? (
        <span class="badge alt">{p.tags[0].label}</span>
      ) : (
        <div class="case-tags">
          {p.tags.map((t) => <span class={t.win ? 'badge win' : 'badge alt'}>{t.label}</span>)}
        </div>
      )}
      <h3 set:html={p.titleHtml}></h3>
      <p class="prob" set:html={p.problemHtml}></p>
      {p.visual === 'tree' && <DecisionTree />}
      {p.visual === 'gap' && <GapDiagram />}
      {p.ownershipHtml && <p class="ownership" set:html={p.ownershipHtml}></p>}
      <p class="result" set:html={p.resultHtml}></p>
    </div>
    <div class="case-body">
      <span class="micro-label">{p.micro}</span>
      <ul class="approach">
        {p.approachHtml.map((li) => <li set:html={li}></li>)}
      </ul>
      <div class="chips">{p.chips.map((c) => <span class="chip">{c}</span>)}</div>
    </div>
  </div>
</article>
