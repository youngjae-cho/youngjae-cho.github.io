---
import Base from '../layouts/Base.astro';
import PubCard from '../components/PubCard.astro';
import PageHead from '../components/PageHead.astro';
import { publications, inProgress } from '../data/publications';

// The four papers I led. Co-authored workshop and conference work is kept in
// the data — the résumé lists every publication — but held back from here,
// because four papers answering one question read as a body of work and six
// papers with two of them unrelated read as a list.
const pubs = publications
  .filter((p) => !p.minor)
  .sort((a, b) => b.date.localeCompare(a.date));
---
<Base title="Publications — Youngjae Cho" active="publications">
  <main class="wrap">
    <PageHead section="Research" count={`${pubs.length} papers`} eyebrow="Research" title="Publications">
      <p class="intro">Four papers, one question: how do you train well when the data is too little or the labels are wrong? Each pulls a different lever — <em>which</em> samples to label, how to <em>adapt</em> when there are few, how to <em>synthesize</em> what's missing, and how to keep the optimization <em>stable</em> when the signal is noisy. First or co-first author on all four; two published at ICML 2023 and AAAI 2024, two preprints.</p>
    </PageHead>
    <section class="block">
      <div class="grid">
        {pubs.map((p, i) => <PubCard pub={p} index={i + 1} total={pubs.length} />)}
      </div>
    </section>

    {/* Stated, not described. Each row gives the topic and the question and
        then stops, because there is no result yet — the blacked-out lines are
        the honest rendering of that, and they disappear when a row graduates
        into a paper above. */}
    <section class="block" id="in-progress" style="border-bottom:0">
      <div class="head">
        <div class="eyebrow">In progress</div>
        <h2>Two lines still open.</h2>
        <p>Neither is public and neither has a result to report. They're here because they're where the work is going, and because both extend threads already on this site — the temporal localization behind the hackathon entry, and the safety side of the moderation stack.</p>
      </div>
      <div class="wip">
        {inProgress.map((w) => (
          <article class="wip-row ticked">
            <div class="wip-meta">
              <span class="wip-status">Unpublished</span>
              <span class="wip-id">No result yet</span>
            </div>
            <div>
              <h3>{w.topic}</h3>
              <p class="wip-q">{w.question}</p>
              <div class="wip-redact" role="img" aria-label="Findings withheld — no result to report yet">
                <i></i><i></i><i></i>
              </div>
              <span class="wip-withheld">Findings withheld</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>
