---
import Base from '../layouts/Base.astro';
import PubCard from '../components/PubCard.astro';
import PageHead from '../components/PageHead.astro';
import { publications, inProgress } from '../data/publications';
import { academicService, awards } from '../data/cv';

// Led papers form the main research record. The résumé also includes the
// co-authored workshop and conference publications kept in the shared data.
const pubs = publications
  .filter((p) => !p.minor)
  .sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)) || b.date.localeCompare(a.date));
---
<Base title="Publications — Youngjae Cho" active="publications">
  <main class="wrap">
    <PageHead section="Research" count={`${pubs.length} papers`} eyebrow="Research" title="Publications">
      <p class="intro">Five papers on learning under imperfect supervision — selecting useful samples, adapting with scarce data, synthesizing missing examples, stabilizing preference optimization, and verifying temporal predictions in video. First or co-first author on all five: GAPO accepted to NeurIPS 2026, work published at ICML 2023 and AAAI 2024, and two preprints, including SUTURE on video temporal grounding.</p>
    </PageHead>
    <section class="block">
      <div class="grid">
        {pubs.map((p, i) => <PubCard pub={p} index={i + 1} total={pubs.length} />)}
      </div>
    </section>

    <section class="block" id="service-and-awards" aria-labelledby="service-heading">
      <div class="head">
        <div class="eyebrow">Community</div>
        <h2 id="service-heading">Academic Service</h2>
      </div>
      <ul class="approach">
        {academicService.map((s) => <li><b>{s.venue} {s.date}</b> — {s.role}</li>)}
      </ul>
      <div class="head" style="margin-top:32px">
        <div class="eyebrow">Recognition</div>
        <h2>Awards</h2>
      </div>
      {awards.map((a) => (
        <div class="head">
          <p><b>{a.date} · {a.name}</b></p>
          <p>{a.detail}</p>
        </div>
      ))}
    </section>

    {/* Stated, not described. Each row gives the topic and the question and
        then stops, because there is no result yet — the blacked-out lines are
        the honest rendering of that, and they disappear when a row graduates
        into a paper above. */}
    <section class="block" id="in-progress" style="border-bottom:0">
      <div class="head">
        <div class="eyebrow">In progress</div>
        <h2>{inProgress.length === 1 ? 'One line still open.' : `${inProgress.length} lines still open.`}</h2>
        <p>Safe diffusion remains in progress, extending the safety side of the moderation stack. Findings are withheld until the work is public.</p>
      </div>
      <div class="wip">
        {inProgress.map((w) => (
          <article class="wip-row ticked">
            <div class="wip-meta">
              <span class="wip-status">Unpublished</span>
              <span class="wip-id">No result yet</span>
            </div>
            <div>
              <h3>{w.topic}</h3>
              <p class="wip-q">{w.question}</p>
              <div class="wip-redact" role="img" aria-label="Findings withheld — no result to report yet">
                <i></i><i></i><i></i>
              </div>
              <span class="wip-withheld">Findings withheld</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>
