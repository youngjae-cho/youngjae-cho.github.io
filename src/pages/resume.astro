---
import Base from '../layouts/Base.astro';
import { basics, work, education, skills, awards } from '../data/cv';
import { publications } from '../data/publications';

// One-to-two pages. Everything here comes from the same data files that drive the
// site, so the résumé and the pages can never drift apart.
const pubs = [...publications].sort((a, b) => b.date.localeCompare(a.date));
const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
---
<Base title="Résumé — Youngjae Cho" active="resume">
  <main class="wrap resume">
    <div class="resume-actions">
      <div class="eyebrow">Résumé · 2 pages</div>
      <div class="ra-links">
        <button class="ra-btn" id="print-resume" type="button">Print / Save as PDF</button>
        <a class="ra-btn alt" href={basics.portfolio}>Research portfolio — {basics.portfolioPages}p PDF ↓</a>
      </div>
    </div>

    <article class="sheet">
      <header class="sheet-head">
        <h1>{basics.name}</h1>
        <p class="role">{basics.label}</p>
        <p class="contact">
          <a href={`mailto:${basics.email}`}>{basics.email}</a> · {basics.location} ·
          <a href={basics.links.github}>github.com/youngjae-cho</a> ·
          <a href={basics.links.scholar}>Google Scholar</a> ·
          <a href={basics.links.linkedin}>linkedin.com/in/offonoff</a>
        </p>
        <p class="summary">{basics.summaryLong}</p>
      </header>

      <section class="rs">
        <h2>Experience</h2>
        {work.map((j) => (
          <div class="rs-item">
            <div class="rs-line">
              <span class="rs-title">{j.role} · {j.org}</span>
              <span class="rs-when">{j.start} — {j.end}</span>
            </div>
            {j.note && <p class="rs-note">{j.note}</p>}
            <ul>{j.highlights.map((h) => <li>{h}</li>)}</ul>
          </div>
        ))}
      </section>

      <section class="rs">
        <h2>Education</h2>
        {education.map((e) => (
          <div class="rs-item">
            <div class="rs-line">
              <span class="rs-title">{e.degree} · {e.org}</span>
              <span class="rs-when">{e.start} — {e.end}</span>
            </div>
            {e.note && <p class="rs-note">{e.note}</p>}
            {e.detail && <p class="rs-detail">{e.detail}</p>}
          </div>
        ))}
      </section>

      <section class="rs">
        <h2>Publications</h2>
        <ul class="rs-pubs">
          {pubs.map((p) => (
            <li>
              <span class="rs-pub-title">{p.title}</span>
              <span class="rs-authors" set:html={bold(p.authors)}></span>
              <span class="rs-venue">{p.venue} · {p.status}{p.role ? ` · ${p.role}` : ''}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="rs">
        <h2>Awards</h2>
        {awards.map((a) => (
          <div class="rs-item">
            <div class="rs-line">
              <span class="rs-title">{a.name}</span>
              <span class="rs-when">{a.date}</span>
            </div>
            <p class="rs-detail">{a.detail}</p>
          </div>
        ))}
      </section>

      <section class="rs">
        <h2>Skills</h2>
        <dl class="rs-skills">
          {skills.map((s) => (
            <>
              <dt>{s.name}</dt>
              <dd>{s.items.join(' · ')}</dd>
            </>
          ))}
        </dl>
      </section>
    </article>
  </main>
</Base>

<script>
  document.getElementById('print-resume')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  /* ---- screen ---- */
  .resume{padding-bottom:60px}
  .resume-actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;padding:76px 0 26px}
  .ra-links{display:flex;flex-wrap:wrap;gap:9px}
  .ra-btn{
    font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;
    border:1.5px solid var(--accent);padding:8px 15px;
    background:var(--accent-soft);color:var(--accent);cursor:pointer;
    transition:background .2s,color .2s;
    clip-path:polygon(0 0,100% 0,100% 64%,92% 100%,0 100%);
  }
  .ra-btn:hover{background:var(--accent);color:#06080b}
  .ra-btn.alt{border-color:var(--line);color:var(--ink-2);background:transparent;text-decoration:none;display:inline-flex;align-items:center}
  .ra-btn.alt:hover{border-color:var(--accent);color:var(--accent-ink);background:transparent}

  .sheet{position:relative;background:var(--card);border:1px solid var(--line);padding:44px 46px}
  .sheet::before,.sheet::after{
    content:"";position:absolute;width:11px;height:11px;pointer-events:none;
    border-color:var(--accent);opacity:.7;
  }
  .sheet::before{top:-1px;left:-1px;border-top:1.5px solid;border-left:1.5px solid}
  .sheet::after{bottom:-1px;right:-1px;border-bottom:1.5px solid;border-right:1.5px solid}
  @media(max-width:620px){.sheet{padding:28px 22px}}
  .sheet-head h1{font-size:2rem;font-weight:800;letter-spacing:-.03em;margin:0;line-height:1.1}
  .sheet-head .role{margin:4px 0 0;font-family:var(--mono);font-size:.84rem;color:var(--accent-ink);letter-spacing:.04em}
  .sheet-head .contact{margin:10px 0 0;font-family:var(--mono);font-size:.76rem;color:var(--ink-2);line-height:1.7}
  .sheet-head .contact a{border-bottom:1px solid var(--line)}
  .sheet-head .summary{margin:14px 0 0;font-size:.98rem;color:var(--ink);max-width:70ch;line-height:1.55}

  .rs{margin-top:26px;padding-top:18px;border-top:1px solid var(--line-2)}
  .rs h2{
    font-family:var(--mono);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;
    color:var(--ink-3);font-weight:600;margin:0 0 14px;
  }
  .rs-item{margin-bottom:16px;break-inside:avoid}
  .rs-item:last-child{margin-bottom:0}
  .rs-line{display:flex;gap:16px;align-items:baseline;justify-content:space-between;flex-wrap:wrap}
  .rs-title{font-size:1rem;font-weight:700;letter-spacing:-.01em}
  .rs-when{font-family:var(--mono);font-size:.76rem;color:var(--ink-3);font-variant-numeric:tabular-nums;white-space:nowrap}
  .rs-note{margin:2px 0 0;font-family:var(--mono);font-size:.74rem;color:var(--accent-ink)}
  .rs-detail{margin:5px 0 0;font-size:.9rem;color:var(--ink-2);line-height:1.5;max-width:74ch}
  .rs-item ul{margin:7px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:5px}
  .rs-item ul li{position:relative;padding-left:16px;font-size:.9rem;color:var(--ink-2);line-height:1.5;max-width:80ch}
  .rs-item ul li::before{content:"";position:absolute;left:0;top:.62em;width:7px;height:1.5px;background:var(--accent)}

  .rs-pubs{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:11px}
  .rs-pubs li{display:flex;flex-direction:column;gap:2px;break-inside:avoid}
  .rs-pub-title{font-size:.94rem;font-weight:650;line-height:1.35}
  .rs-authors{font-size:.82rem;color:var(--ink-2);line-height:1.4}
  .rs-authors b{color:var(--ink);font-weight:700}
  .rs-venue{font-family:var(--mono);font-size:.74rem;color:var(--accent-ink);letter-spacing:.02em}

  .rs-skills{margin:0;display:grid;grid-template-columns:210px 1fr;gap:8px 20px}
  @media(max-width:620px){.rs-skills{grid-template-columns:1fr;gap:2px 0}}
  .rs-skills dt{font-family:var(--mono);font-size:.74rem;letter-spacing:.06em;color:var(--ink-3);text-transform:uppercase}
  .rs-skills dd{margin:0;font-size:.9rem;color:var(--ink-2);line-height:1.5}

  /* ---- print: the sheet is the page ----
     The site theme is a dark console; paper is the opposite. Everything that
     makes the screen version work — near-white ink, the CRT scanline overlay,
     amber-on-black — has to be inverted or removed here, or the printout is
     blank white-on-white with scanlines over it. */
  @media print{
    @page{size:A4;margin:13mm 14mm}
    html,body{background:#fff !important;color:#14181d !important}
    .crt{display:none !important}
    nav,footer,.resume-actions{display:none !important}
    .resume{padding:0}
    .wrap{max-width:none;padding:0}
    .sheet{border:0;padding:0;background:#fff}
    .sheet::before,.sheet::after{display:none}
    /* Re-ink for paper: near-black body, mid-grey secondary, dark amber accent. */
    .sheet,.sheet *{color:#14181d !important}
    .sheet-head .contact,.rs-detail,.rs-item ul li,.rs-authors,.rs-skills dd{color:#3d444d !important}
    .rs h2,.rs-when,.rs-skills dt{color:#6b7480 !important}
    .sheet-head .role,.rs-note,.rs-venue{color:#8a5a08 !important}
    .rs-authors b{color:#14181d !important}
    .rs-item ul li::before{background:#8a5a08 !important}
    .rs,.sheet-head{border-color:#d5dae0 !important}
    .sheet-head h1{font-size:20pt}
    .sheet-head .role{font-size:9pt}
    .sheet-head .contact{font-size:8pt}
    .sheet-head .summary{font-size:9.2pt;margin-top:9px}
    .rs{margin-top:13px;padding-top:9px}
    .rs h2{font-size:7.5pt;margin-bottom:8px}
    .rs-item{margin-bottom:10px}
    .rs-title{font-size:10pt}
    .rs-when,.rs-note{font-size:8pt}
    .rs-detail,.rs-item ul li{font-size:9pt;line-height:1.4}
    .rs-pub-title{font-size:9pt}
    .rs-authors{font-size:8pt}
    .rs-venue{font-size:7.8pt}
    .rs-skills dt{font-size:8pt}
    .rs-skills dd{font-size:9pt}
    a{color:inherit !important;border:0 !important;text-decoration:none !important}
  }
</style>
