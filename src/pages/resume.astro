---
import Base from '../layouts/Base.astro';
import CVPublication from '../components/CVPublication.astro';
import { basics, researchExperience, education, awards, academicService } from '../data/cv';
import { selectedPublications, additionalPublications } from '../data/publications';

// Download and Print deliberately share the same typeset, two-page document.
const cvPDF = '/cv/Youngjae_Cho_CV.pdf?v=20261022';
const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
const date = (value: string) => {
  if (value === 'present') return 'Present';
  const [year, month] = value.split('.');
  return ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][Number(month) - 1] + ' ' + year;
};
---
<Base title="Academic CV — Youngjae Cho" active="resume" pageClass="cv-page">
  <main class="resume-shell">
    <div class="resume-actions">
      <span class="eyebrow">Academic CV</span>
      <div class="ra-links">
        <a class="ra-btn" href={cvPDF} download="Youngjae_Cho_CV.pdf">Download PDF</a>
        <a class="ra-btn alt" href={cvPDF} target="_blank" rel="noopener" title="Open the PDF and use the viewer's Print button" aria-label="Print CV (opens PDF in a new tab)">Print CV</a>
      </div>
    </div>

    <article class="academic-cv" aria-label="Youngjae Cho academic curriculum vitae">
      <header class="cv-header">
        <div class="cv-identity">
          <h1>{basics.name}</h1>
          <p class="cv-role">{basics.label}</p>
          <p class="cv-location">{basics.location}</p>
        </div>
        <address class="cv-contact">
          <a href={'mailto:' + basics.email}>{basics.email}</a>
          <a href="https://youngjae-cho.github.io/">youngjae-cho.github.io</a>
          <span><a href={basics.links.github}>GitHub</a><i aria-hidden="true"> · </i><a href={basics.links.scholar}>Google Scholar</a></span>
        </address>
      </header>

      <p class="cv-focus">{basics.researchInterests}</p>

      <section class="cv-section" aria-labelledby="cv-education">
        <h2 id="cv-education">Education</h2>
        {education.map((e) => (
          <div class="cv-entry">
            <div class="cv-entry-heading">
              <h3><b>{e.org}</b><span class="cv-separator"> · </span><span class="cv-degree">{e.degree}</span></h3>
              <span class="cv-date">{date(e.start)} – {date(e.end)}</span>
            </div>
            {e.note && <p class="cv-meta">{e.note.replace('advised by ', 'Advisor: ')}</p>}
          </div>
        ))}
      </section>

      <section class="cv-section" aria-labelledby="cv-selected">
        <h2 id="cv-selected">Selected Publications</h2>
        <p class="cv-section-note">* Equal contribution.</p>
        <ol class="cv-publications">
          {selectedPublications.map((pub, i) => <CVPublication pub={pub} number={i + 1} describe />)}
        </ol>
      </section>

      <section class="cv-section" aria-labelledby="cv-experience">
        <h2 id="cv-experience">Research Experience</h2>
        {researchExperience.map((job) => (
          <div class="cv-entry cv-job">
            <div class="cv-entry-heading">
              <h3>{job.org}</h3>
              <span class="cv-date">{date(job.start)} – {date(job.end)}</span>
            </div>
            <p class="cv-meta">{job.role}</p>
            <ul class="cv-contributions">
              {job.highlights.map((text) => <li set:html={bold(text)}></li>)}
            </ul>
          </div>
        ))}
      </section>

      <section class="cv-section" aria-labelledby="cv-additional">
        <h2 id="cv-additional">Additional Publications</h2>
        <ol class="cv-publications">
          {additionalPublications.map((pub, i) => <CVPublication pub={pub} number={selectedPublications.length + i + 1} />)}
        </ol>
      </section>

      <div class="cv-end-grid">
        <section class="cv-section" aria-labelledby="cv-service">
          <h2 id="cv-service">Academic Service</h2>
          <dl class="cv-service-list">
            {academicService.map((service) => (
              <div><dt>{service.venue} {service.date}</dt><dd>{service.role}</dd></div>
            ))}
          </dl>
        </section>
        <section class="cv-section" aria-labelledby="cv-awards">
          <h2 id="cv-awards">Awards</h2>
          {awards.map((award) => (
            <div class="cv-award">
              <div class="cv-entry-heading">
                <h3>{award.name.split(' — ')[0]}</h3>
                <span class="cv-date">{award.date}</span>
              </div>
              <p class="cv-meta">{award.name.split(' — ')[1]}</p>
              <p class="cv-award-detail">{award.detail}</p>
            </div>
          ))}
        </section>
      </div>
    </article>
  </main>
</Base>

<style is:global>
  .cv-page .crt{display:none}
  .resume-shell{max-width:1000px;margin:0 auto;padding:64px 28px 76px}
  .resume-actions{display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between;margin-bottom:24px}
  .ra-links{display:flex;flex-wrap:wrap;gap:9px}
  .ra-btn{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;border:1px solid var(--accent);padding:9px 14px;color:var(--accent-ink);transition:background .15s,color .15s}
  .ra-btn:hover{background:var(--accent);color:#000}
  .ra-btn.alt{color:var(--ink-2);border-color:#3b3b3b}
  .ra-btn.alt:hover{border-color:var(--accent);color:#000}

  .academic-cv{
    --cv-ink:#20252b;--cv-secondary:#50565e;--cv-link:#244d70;--cv-rule:#d0d4d8;
    background:#fff;color:var(--cv-ink);color-scheme:light;
    padding:62px 64px 64px;
    font-family:Georgia,'Times New Roman',serif;font-size:17px;line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  .academic-cv p,.academic-cv h1,.academic-cv h2,.academic-cv h3{margin:0}
  .academic-cv b{font-weight:700;color:var(--cv-ink)}
  .academic-cv a{color:var(--cv-link);text-decoration:none;overflow-wrap:anywhere}
  .academic-cv a:hover{text-decoration:underline;text-underline-offset:3px}
  .academic-cv a:focus-visible{outline:2px solid var(--cv-link);outline-offset:3px}
  .cv-header{display:flex;align-items:flex-start;justify-content:space-between;gap:28px}
  .academic-cv h1{font-family:Georgia,'Times New Roman',serif;font-size:43px;line-height:1.12;font-weight:700;letter-spacing:-.035em}
  .academic-cv .cv-role{font-size:16px;margin-top:7px}
  .academic-cv .cv-location{font-family:var(--sans);font-size:12px;color:var(--cv-secondary);margin-top:6px}
  .cv-contact{display:flex;flex-direction:column;gap:4px;text-align:right;font-style:normal;font-family:var(--sans);font-size:12px;line-height:1.7;padding-top:5px}
  .cv-contact i{font-style:normal;color:#8b9095;padding:0 5px}
  .academic-cv .cv-focus{margin-top:24px;font-size:16px;line-height:1.6;max-width:76ch}
  .cv-section{margin-top:30px}
  .academic-cv h2{display:flex;align-items:center;gap:14px;font-family:var(--sans);font-size:11px;font-weight:650;line-height:1.4;letter-spacing:.13em;text-transform:uppercase;margin-bottom:15px;color:var(--cv-ink)}
  .academic-cv h2::after{content:"";flex:1;border-top:1px solid var(--cv-rule)}
  .cv-entry+.cv-entry{margin-top:15px}
  .cv-entry-heading{display:flex;justify-content:space-between;align-items:baseline;gap:16px}
  .academic-cv h3{font:700 16px/1.45 Georgia,'Times New Roman',serif;letter-spacing:0}
  .academic-cv .cv-degree{font-weight:400}
  .cv-separator{font-weight:400;color:#8b9095}
  .cv-date{flex:none;font-family:var(--sans);font-size:11.5px;font-variant-numeric:tabular-nums;color:var(--cv-secondary);white-space:nowrap}
  .academic-cv .cv-meta{font-family:var(--sans);font-size:12px;color:var(--cv-secondary);line-height:1.5;margin-top:3px}
  .academic-cv .cv-section-note{font-size:12px;font-style:italic;color:var(--cv-secondary);margin:-7px 0 13px}
  .cv-publications{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:21px}
  .cv-job+.cv-job{margin-top:22px}
  .cv-contributions{margin:9px 0 0;padding-left:17px;font-size:14.5px;line-height:1.65;color:var(--cv-secondary)}
  .cv-contributions li{padding-left:3px}
  .cv-contributions li+li{margin-top:5px}
  .cv-contributions li::marker{font-size:9px;color:#747b82}
  .cv-end-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:32px}
  .cv-service-list{margin:0;font-size:14px;line-height:1.6}
  .cv-service-list div+div{margin-top:10px}
  .cv-service-list dt{font-weight:700}
  .cv-service-list dd{margin:0;color:var(--cv-secondary)}
  .academic-cv .cv-award-detail{font-size:13px;line-height:1.6;color:var(--cv-secondary);margin-top:8px}
  .cv-entry,.cv-publication,.cv-award{break-inside:avoid}
  @media(max-width:850px){
    .academic-cv{padding:46px 38px}
    .cv-header{gap:20px}
    .academic-cv h1{font-size:37px}
    .cv-end-grid{gap:25px}
  }
  @media(max-width:620px){
    .resume-shell{padding:38px 14px 42px}
    .resume-actions{align-items:flex-start;gap:14px}
    .ra-btn{font-size:.63rem;padding:9px 11px}
    .academic-cv{padding:31px 23px 36px}
    .cv-header{display:block}
    .academic-cv h1{font-size:35px}
    .cv-contact{text-align:left;gap:2px;margin-top:16px}
    .academic-cv .cv-focus{font-size:15px;margin-top:21px}
    .cv-entry-heading{flex-wrap:wrap;gap:3px}
    .cv-date{display:block;width:100%}
    .academic-cv h3{font-size:15px}
    .cv-section{margin-top:27px}
    .academic-cv h2{font-size:10.5px}
    .cv-end-grid{display:block}
    .cv-contributions{font-size:14px}
  }
  @media print{
    @page{size:letter;margin:16mm 17mm}
    html.cv-page,.cv-page body{background:#fff!important;color:#20252b!important}
    .cv-page nav,.cv-page footer,.cv-page .resume-actions{display:none!important}
    .resume-shell{max-width:none;padding:0}
    .academic-cv{padding:0;font-size:10pt}
    .academic-cv h1{font-size:27pt}
    .academic-cv .cv-focus{font-size:10pt}
    .cv-section{margin-top:15pt}
    .academic-cv h2{font-size:9pt;margin-bottom:9pt}
    .academic-cv h3{font-size:10.5pt}
    .cv-contributions{font-size:9pt;line-height:1.45}
    .cv-contact,.cv-date,.academic-cv .cv-meta{font-size:8pt}
    .cv-publications{gap:12pt}
    .academic-cv a{color:#244d70}
  }
</style>
