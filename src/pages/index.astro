---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';

// The home page is two panels and stops: who this is, then the console. Nothing
// follows, because everything that used to follow is what the console leads to
// — the papers, the case studies, the résumé. A summary sitting under the
// console is a page arguing with its own navigation.
//
// No status bar and no footer for the same reason. The intro carries the direct
// links (publications, résumé, email) for anyone who doesn't want the console.
---
<Base nav={false} footer={false} pageClass="home">
  <Hero />
</Base>
