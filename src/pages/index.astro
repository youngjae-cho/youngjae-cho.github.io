---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ledger from '../components/Ledger.astro';
import PubCard from '../components/PubCard.astro';
import { publications } from '../data/publications';
import { projects } from '../data/projects';
import { work } from '../data/cv';

// The home page is a trailer, not the catalogue: one feature plus two, and the
// two systems that carry the most weight. Everything else lives one click away.
const homePubs = publications.filter((p) => p.home).slice(0, 3);
const homeProjects = projects.slice(0, 2);
---
<Base>
  <Hero />
  <Ledger />
  <main class="wrap">
    <!-- SELECTED RESEARCH -->
    <section class="block" id="research">
      <div class="head">
        <div class="eyebrow">Selected Research</div>
        <h2>Robust learning when supervision is noisy, scarce, or shifting.</h2>
        <p>That's the throughline — the failure mode each paper attacks. The methods vary: <em>optimization geometry</em> for noisy preferences, <em>acquisition</em> for scarce labels, <em>Bayesian priors</em> for shift, <em>generative synthesis</em> for scarce anomalies.</p>
        <a class="section-link" href="/publications">All publications <span class="arr">→</span></a>
      </div>
      <div class="grid">
        {homePubs.map((p) => <PubCard pub={p} compact />)}
      </div>
    </section>

    <!-- ENGINEERING -->
    <section class="block" id="engineering">
      <div class="head">
        <div class="eyebrow">Engineering &amp; Production</div>
        <h2>And then I ship it.</h2>
        <p>The two that carry the most weight — the auto-labeling system I own, and the post-training that won an NVIDIA hackathon track. Two more from Aiv on the case-studies page.</p>
        <a class="section-link" href="/projects">Full case studies <span class="arr">→</span></a>
      </div>
      <div class="grid">
        {homeProjects.map((p) => (
          <a class="card" href={`/projects#${p.key}`}>
            <div class="card-top">
              {p.tags.map((t) => <span class={t.win ? 'badge win' : 'badge alt'}>{t.label}</span>)}
            </div>
            <h3 set:html={p.titleHtml}></h3>
            <p>{p.blurb}</p>
            <span class="more">Case study <span class="arr">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="block" id="experience">
      <div class="head">
        <div class="eyebrow">Experience &amp; Education</div>
        <h2>From an industrial-engineering lab to production ML.</h2>
        <a class="section-link" href="/resume">Full résumé <span class="arr">→</span></a>
      </div>
      <div class="tl">
        {work.map((j) => (
          <div class="row">
            <div class="when">{j.start} — {j.end}</div>
            <div class="what">
              <h4>{j.role}</h4>
              <div class="org">{j.org}{j.note ? ` · ${j.note}` : ''}</div>
              <p>{j.highlights[0]}</p>
            </div>
          </div>
        ))}
        <div class="row">
          <div class="when">2017 — 2024</div>
          <div class="what">
            <h4>B.S. &amp; M.S., Industrial &amp; Systems Engineering</h4>
            <div class="org">KAIST · advised by Il-Chul Moon</div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
