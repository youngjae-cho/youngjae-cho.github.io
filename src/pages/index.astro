---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ledger from '../components/Ledger.astro';
import { work } from '../data/cv';

// The home page is the hub, not the catalogue. The MAGI panel in the hero is
// the way in, and each of its three plates opens the page that holds the real
// listing. What used to sit here was a second copy of those pages — four paper
// cards and two case-study cards, maintained twice and read once. Both grids
// are gone; what stays is the summary each destination earns, plus the one
// thing no other page carries in full, the timeline.
---
<Base nav={false}>
  <Hero />
  <Ledger />
  <main class="wrap">
    <!-- SELECTED RESEARCH -->
    <section class="block summary" id="research">
      <div class="head">
        <div class="eyebrow">Selected Research</div>
        <h2>Robust learning when supervision is noisy, scarce, or shifting.</h2>
        <p>Six papers, four first-author, one theme: the failure mode each one attacks. The methods vary — <em>optimization geometry</em> for noisy preferences, <em>acquisition</em> for scarce labels, <em>Bayesian priors</em> for shift, <em>generative synthesis</em> for scarce anomalies — but the question doesn't.</p>
        <a class="section-link" href="/publications">All publications <span class="arr">→</span></a>
      </div>
    </section>

    <!-- ENGINEERING -->
    <section class="block summary" id="engineering">
      <div class="head">
        <div class="eyebrow">Engineering &amp; Production</div>
        <h2>And then I ship it.</h2>
        <p>Five systems across Pyler and Aiv — the auto-labeling system I own, the serving layer beneath it, the post-training that won an NVIDIA hackathon track, and two more from Aiv. Each written the same way: the problem, what was mine, and what moved.</p>
        <a class="section-link" href="/projects">Full case studies <span class="arr">→</span></a>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="block" id="experience">
      <div class="head">
        <div class="eyebrow">Experience &amp; Education</div>
        <h2>From an industrial-engineering lab to production ML.</h2>
        <a class="section-link" href="/resume">Full résumé <span class="arr">→</span></a>
      </div>
      <div class="tl">
        {work.map((j) => (
          <div class="row">
            <div class="when">{j.start} — {j.end}</div>
            <div class="what">
              <h4>{j.role}</h4>
              <div class="org">{j.org}{j.note ? ` · ${j.note}` : ''}</div>
              <p>{j.highlights[0]}</p>
            </div>
          </div>
        ))}
        <div class="row">
          <div class="when">2017 — 2024</div>
          <div class="what">
            <h4>B.S. &amp; M.S., Industrial &amp; Systems Engineering</h4>
            <div class="org">KAIST · advised by Il-Chul Moon</div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
