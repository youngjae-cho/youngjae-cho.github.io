---
import Base from '../layouts/Base.astro';
import CaseStudy from '../components/CaseStudy.astro';
import PageHead from '../components/PageHead.astro';
import { projects } from '../data/projects';

// BALTHASAR·2 on the console panel lands here — its sub-line reads
// "training · inference · serving", which is precisely these two.
const cases = projects.filter((p) => p.track === 'engineering');
---
<Base title="Engineering — Youngjae Cho" active="engineering">
  <main class="wrap">
    <PageHead section="Engineering" count={`${cases.length} cases`} eyebrow="Engineering" title="Engineering">
      <p class="intro">Two systems built so other work could run: the serving layer beneath the moderation stack, and the RL post-training framework a 12B VLM didn't have. Neither is a model — one decides how a model reaches traffic, the other whether it can be trained at all.</p>
    </PageHead>
    <section class="block" style="border-bottom:0">
      <div class="cases">
        {cases.map((p, i) => <CaseStudy project={p} index={i + 1} total={cases.length} />)}
      </div>
    </section>
  </main>
</Base>
