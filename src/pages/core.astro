---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

// The centre of the MAGI figure lands here — the one destination on the console
// that isn't work. It is deliberately not in the nav: the console's centre is
// how you find it, and a bar link would make it a fourth section of the
// portfolio rather than the thing on the other side of the field.
//
// Everything here runs amber instead of the site's red. That is one token flip
// (see the .core block in global.css) and it is doing real work: red is the job
// on every other page, so a visitor who lands on amber knows before reading a
// word that the rules changed.
const CHANNEL = 'https://youtube.com/@moodrainbow';

// Titles stay in Korean because that is what they are called; translating them
// would be inventing a second name for a real thing. Neither shipped font
// covers Hangul, so those glyphs fall through to the system stack the same way
// the console's ▸ ■ ▼ marks do — which is why the title is set in the body sans
// and only the count is mono.
//
// TODO: href — the two watch URLs did not survive the paste (the links came
// through as empty placeholders) and youtube.com is blocked by this
// environment's egress proxy, so they could not be looked up either. Both rows
// point at the channel until the real URLs are in hand; swap these two strings.
const sets = [
  { views: '3.5M', title: '코딩할 때 듣기 좋은 로파이 재즈 힙합', href: CHANNEL },
  { views: '3.2M', title: '과제 할 때 집중 하기 좋은 로파이 재즈 힙합', href: CHANNEL },
];
---
<Base
  title="Elsewhere — Youngjae Cho"
  description="Youngjae Cho outside the work — moodrainbow, a lo-fi and jazz playlist channel."
  pageClass="core"
>
  <main class="wrap">
    <PageHead section="Core" count="1 channel" eyebrow="Off duty" title="Elsewhere">
      <p class="intro">The console's three nodes are all the same person at work. This is the part that isn't.</p>
    </PageHead>

    <section class="block" style="border-bottom:0">
      <article class="offd">
        <div class="offd-top">
          <span class="badge">YouTube</span>
          <span class="offd-tag">Lo-fi · Jazz</span>
        </div>
        <h2><a href={CHANNEL} rel="me noopener" target="_blank">Mood Rainbow</a></h2>
        {/* One sentence on what the work was, then the evidence. No "first",
            no "pioneer" — the date is carried by "before … became a familiar
            format", and 3.5M sitting underneath it lets a reader draw the
            conclusion themselves, which lands harder than claiming it. */}
        <p>I made lo-fi playlists around specific moments — coding, studying, late-night work — before “coding lofi” became a familiar format in Korea.</p>
        <ol class="offd-list">
          {sets.map((s) => (
            <li>
              <a class="offd-row" href={s.href} rel="noopener" target="_blank"
                 aria-label={`${s.views} views — ${s.title}`}>
                <span class="offd-n">{s.views}<i>views</i></span>
                <span class="offd-t">{s.title}</span>
                <span class="offd-go" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
        <a class="more" href={CHANNEL} rel="me noopener" target="_blank">
          youtube.com/@moodrainbow <span class="arr" aria-hidden="true">→</span>
        </a>
      </article>
    </section>
  </main>
</Base>
