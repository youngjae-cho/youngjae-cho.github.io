---
import Base from '../layouts/Base.astro';
import CaseStudy from '../components/CaseStudy.astro';
import { projects } from '../data/projects';
---
<Base title="Projects — Youngjae Cho" active="projects">
  <main class="wrap">
    <header class="page-head">
      <div class="eyebrow">Engineering &amp; Production</div>
      <h1>Projects</h1>
      <p class="intro">Five systems across Pyler and Aiv, each written the same way: the problem, what was mine, and what moved. Three are products I owned end to end — content-safety auto-labeling, defect synthesis on a production line, and a real-time OCR pipeline. One is the serving layer beneath the moderation stack; one is the post-training that won an NVIDIA hackathon track.</p>
    </header>
    <section class="block" style="border-bottom:0">
      <div class="cases">
        {projects.map((p) => <CaseStudy project={p} />)}
      </div>
    </section>
  </main>
</Base>
